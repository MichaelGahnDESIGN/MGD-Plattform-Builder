{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelGahnDESIGN/Projekt-Plattform-System/schema/release-notes.schema.json",
  "title": "MGD Release Notes",
  "description": "File-based release notes. Frontends show only entries for the frontend audience; backoffices show all.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date", "audience", "type", "title"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "status": {
            "type": "string",
            "enum": ["pre-alpha", "alpha", "beta", "pre-release", "release", "stable", "staging", "hotfix", "lts", "deprecated"]
          },
          "date": { "type": "string", "format": "date" },
          "audience": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["frontend", "backoffice", "editor", "platform", "game", "api"] },
            "uniqueItems": true
          },
          "type": { "type": "string", "enum": ["feature", "patch", "fix", "security", "breaking", "deploy"] },
          "title": { "type": "string", "minLength": 1 },
          "items": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
