{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MGD Platform Module Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "core",
        "feature",
        "commercial",
        "theme",
        "skin",
        "adapter"
      ]
    },
    "description": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "events_subscribed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "events_emitted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "backoffice": {
      "type": "boolean"
    },
    "entitlement": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "private",
          "sensitive",
          "restricted"
        ]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
