{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelGahnDESIGN/Projekt-Plattform-System/schema/mgd-platform.schema.json",
  "title": "MGD Project Platform Profile",
  "description": "Project-neutral profile consumed by humans and coding agents.",
  "type": "object",
  "required": [
    "project",
    "market",
    "languages",
    "features",
    "infrastructure"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "type",
        "foundation_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "general",
            "game",
            "community",
            "creator",
            "ecommerce",
            "internal",
            "custom"
          ]
        },
        "foundation_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "description": {
          "type": "string"
        },
        "public_repository": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "market": {
      "type": "object",
      "required": [
        "countries"
      ],
      "properties": {
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "uniqueItems": true
        },
        "planned_countries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "required": [
        "default",
        "enabled"
      ],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 2
        },
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "prepared": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "hosting": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "boolean"
        },
        "organizations": {
          "type": "boolean"
        },
        "moderation": {
          "type": "boolean"
        },
        "support": {
          "type": "boolean"
        },
        "billing": {
          "type": "boolean"
        },
        "uploads": {
          "type": "boolean"
        },
        "cms": {
          "type": "boolean"
        },
        "translations": {
          "type": "boolean"
        },
        "public_profiles": {
          "type": "boolean"
        },
        "notifications": {
          "type": "boolean"
        },
        "store": {
          "type": "boolean"
        },
        "themes": {
          "type": "boolean"
        },
        "plugins": {
          "type": "boolean"
        },
        "analytics": {
          "type": "boolean"
        },
        "ai_agents": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "properties": {
        "personal_data": {
          "type": "boolean"
        },
        "sensitive_data": {
          "type": "boolean"
        },
        "data_subject_portal": {
          "type": "boolean"
        },
        "retention_policy": {
          "type": "boolean"
        },
        "dpia_screening": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "compliance": {
      "type": "object",
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "legal_library": {
          "type": "boolean"
        },
        "review_required_before_public_launch": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "properties": {
        "mfa_privileged": {
          "type": "boolean"
        },
        "audit_log": {
          "type": "boolean"
        },
        "security_events": {
          "type": "boolean"
        },
        "secret_management": {
          "type": "boolean"
        },
        "incident_response": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "infrastructure": {
      "type": "object",
      "required": [
        "docker",
        "staging",
        "git_source"
      ],
      "properties": {
        "docker": {
          "type": "boolean"
        },
        "staging": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "nas",
            "cloud",
            "managed",
            "custom"
          ]
        },
        "git_source": {
          "type": "string",
          "enum": [
            "github",
            "gitea",
            "gitlab",
            "other"
          ]
        },
        "git_mirror": {
          "type": [
            "string",
            "null"
          ]
        },
        "backup": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "nas",
            "cloud",
            "hybrid",
            "custom"
          ]
        },
        "monitoring": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "agents": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "read_project_rules_first": {
          "type": "boolean"
        },
        "production_changes_require_approval": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "release_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "backoffice": {
      "type": "object",
      "description": "Internal backoffice shell and role-oriented UX views. Views never replace server-side authorization.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "shared_shell": {
          "type": "boolean",
          "default": true
        },
        "default_route": {
          "type": "string"
        },
        "role_views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "actor_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "human",
                    "service_principal",
                    "ai_agent"
                  ]
                },
                "uniqueItems": true
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "landing": {
                "type": "string"
              },
              "navigation_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "read_only": {
                "type": "boolean",
                "default": false
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "ai_agents": {
                "const": true
              }
            },
            "required": [
              "ai_agents"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "required": [
          "agents"
        ],
        "properties": {
          "agents": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "billing": {
                "const": true
              }
            },
            "required": [
              "billing"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "required": [
          "security"
        ],
        "properties": {
          "security": {
            "required": [
              "audit_log"
            ],
            "properties": {
              "audit_log": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "privacy": {
            "properties": {
              "sensitive_data": {
                "const": true
              }
            },
            "required": [
              "sensitive_data"
            ]
          }
        },
        "required": [
          "privacy"
        ]
      },
      "then": {
        "required": [
          "security"
        ],
        "properties": {
          "security": {
            "required": [
              "audit_log",
              "mfa_privileged",
              "incident_response"
            ],
            "properties": {
              "audit_log": {
                "const": true
              },
              "mfa_privileged": {
                "const": true
              },
              "incident_response": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "privacy": {
            "properties": {
              "personal_data": {
                "const": true
              }
            },
            "required": [
              "personal_data"
            ]
          }
        },
        "required": [
          "privacy"
        ]
      },
      "then": {
        "properties": {
          "privacy": {
            "required": [
              "retention_policy"
            ],
            "properties": {
              "retention_policy": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
