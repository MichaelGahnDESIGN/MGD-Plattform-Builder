{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelGahnDESIGN/Projekt-Plattform-System/schema/mgd-platform.schema.json",
  "title": "MGD Project Platform Profile",
  "description": "Project-neutral profile consumed by humans and coding agents.",
  "type": "object",
  "required": [
    "project",
    "market",
    "languages",
    "features",
    "infrastructure"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "type",
        "foundation_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "general",
            "game",
            "community",
            "creator",
            "ecommerce",
            "internal",
            "custom"
          ]
        },
        "foundation_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "description": {
          "type": "string"
        },
        "public_repository": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "market": {
      "type": "object",
      "required": [
        "countries"
      ],
      "properties": {
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "uniqueItems": true
        },
        "planned_countries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "required": [
        "default",
        "enabled"
      ],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 2
        },
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "prepared": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "hosting": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "boolean"
        },
        "organizations": {
          "type": "boolean"
        },
        "moderation": {
          "type": "boolean"
        },
        "support": {
          "type": "boolean"
        },
        "billing": {
          "type": "boolean"
        },
        "uploads": {
          "type": "boolean"
        },
        "cms": {
          "type": "boolean"
        },
        "translations": {
          "type": "boolean"
        },
        "public_profiles": {
          "type": "boolean"
        },
        "notifications": {
          "type": "boolean"
        },
        "store": {
          "type": "boolean"
        },
        "themes": {
          "type": "boolean"
        },
        "plugins": {
          "type": "boolean"
        },
        "analytics": {
          "type": "boolean"
        },
        "ai_agents": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "properties": {
        "personal_data": {
          "type": "boolean"
        },
        "sensitive_data": {
          "type": "boolean"
        },
        "data_subject_portal": {
          "type": "boolean"
        },
        "retention_policy": {
          "type": "boolean"
        },
        "dpia_screening": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "compliance": {
      "type": "object",
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "legal_library": {
          "type": "boolean"
        },
        "review_required_before_public_launch": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "properties": {
        "mfa_privileged": {
          "type": "boolean"
        },
        "audit_log": {
          "type": "boolean"
        },
        "security_events": {
          "type": "boolean"
        },
        "secret_management": {
          "type": "boolean"
        },
        "incident_response": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "infrastructure": {
      "type": "object",
      "required": [
        "docker",
        "staging",
        "git_source"
      ],
      "properties": {
        "docker": {
          "type": "boolean"
        },
        "staging": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "nas",
            "cloud",
            "managed",
            "custom"
          ]
        },
        "git_source": {
          "type": "string",
          "enum": [
            "github",
            "gitea",
            "gitlab",
            "other"
          ]
        },
        "git_mirror": {
          "type": [
            "string",
            "null"
          ]
        },
        "backup": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "nas",
            "cloud",
            "hybrid",
            "custom"
          ]
        },
        "monitoring": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "agents": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "read_project_rules_first": {
          "type": "boolean"
        },
        "production_changes_require_approval": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "release_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "backoffice": {
      "type": "object",
      "description": "Internal backoffice shell and role-oriented UX views. Views never replace server-side authorization.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "shared_shell": {
          "type": "boolean",
          "default": true
        },
        "default_route": {
          "type": "string"
        },
        "role_views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "actor_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "human",
                    "service_principal",
                    "ai_agent"
                  ]
                },
                "uniqueItems": true
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "landing": {
                "type": "string"
              },
              "navigation_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "read_only": {
                "type": "boolean",
                "default": false
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "versioning": {
      "type": "object",
      "description": "Mandatory: project version number (MAJOR.MINOR.PATCH + status), its single source file and where it is displayed.",
      "required": [
        "current",
        "status"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "default": "version.json"
        },
        "current": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pre-alpha",
            "alpha",
            "beta",
            "pre-release",
            "release",
            "stable",
            "staging",
            "hotfix",
            "lts",
            "deprecated"
          ]
        },
        "display": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "show_status": {
              "type": "boolean"
            },
            "audience": {
              "type": "string",
              "enum": [
                "public",
                "private",
                "both"
              ]
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "login",
                  "settings",
                  "game_settings",
                  "backoffice_footer",
                  "public_footer",
                  "public_header",
                  "landing_public",
                  "landing_private",
                  "about"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "release_notes": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source_file": {
              "type": "string",
              "default": "release-notes.json"
            },
            "public_audiences": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "frontend",
                  "backoffice",
                  "editor",
                  "platform",
                  "game",
                  "api"
                ]
              },
              "uniqueItems": true
            },
            "settings_menu_label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cms": {
      "type": "object",
      "description": "CMS pages including mandatory legal pages, editor choice and delivery.",
      "properties": {
        "editor": {
          "type": "string",
          "enum": [
            "tinymce",
            "grapesjs",
            "quill",
            "editorjs",
            "markdown",
            "plain",
            "other"
          ]
        },
        "editor_delivery": {
          "type": "string",
          "enum": [
            "local",
            "cdn"
          ],
          "description": "local = editor files embedded in the app; cdn = loaded from a third-party CDN."
        },
        "revisions": {
          "type": "boolean"
        },
        "import_export": {
          "type": "boolean"
        },
        "trash": {
          "type": "boolean"
        },
        "custom_pages": {
          "type": "boolean"
        },
        "legal_pages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "contact",
              "imprint",
              "terms",
              "privacy",
              "cookies",
              "cookie_banner",
              "payment",
              "shipping",
              "withdrawal",
              "withdrawal_button",
              "youth_protection",
              "accessibility",
              "ai_philosophy",
              "credits"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "credits": {
      "type": "object",
      "description": "Mandatory credits page: people and roles, then all AI systems, tools, plugins, libraries, fonts and icons.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "people": {
          "type": "boolean"
        },
        "components": {
          "type": "boolean"
        },
        "editable_in_backoffice": {
          "type": "boolean"
        },
        "local_assets_only": {
          "type": "boolean",
          "description": "Fonts, icons, logos and libraries are embedded locally, never hotlinked."
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "Backoffice settings must always be searchable and filterable.",
      "properties": {
        "searchable": {
          "type": "boolean"
        },
        "filterable": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "description": "Light and dark mode plus editable design tokens.",
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "uniqueItems": true
        },
        "default_mode": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "toggle": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "header",
                  "footer",
                  "login",
                  "settings",
                  "floating"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "design_tokens_editable": {
          "type": "boolean"
        },
        "design_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "additionalProperties": false
    },
    "file_locations": {
      "type": "object",
      "description": "Where important files live. Paths are relative to the project root and never contain secrets.",
      "properties": {
        "documented_in_backoffice": {
          "type": "boolean"
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "code_editors": {
      "type": "object",
      "description": "Optional backoffice code editors. PHP/server code editing is high risk and needs an extra config flag.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "css",
              "js",
              "php",
              "html",
              "json"
            ]
          },
          "uniqueItems": true
        },
        "php_requires_config_flag": {
          "type": "boolean"
        },
        "backup_before_save": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "description": "Product experience topics that the briefing must clarify.",
      "properties": {
        "updater": {
          "type": "boolean"
        },
        "loading_screen": {
          "type": "boolean"
        },
        "seo": {
          "type": "boolean"
        },
        "cookie_banner": {
          "type": "boolean"
        },
        "maintenance_mode": {
          "type": "boolean"
        },
        "error_pages": {
          "type": "boolean"
        },
        "offline_mode": {
          "type": "boolean"
        },
        "onboarding": {
          "type": "boolean"
        },
        "newsletter": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "analytics_consent": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "template": {
      "type": "object",
      "description": "Starter template the project was created from.",
      "properties": {
        "id": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "uniqueItems": true
        },
        "databases": {
          "type": "object",
          "properties": {
            "core": {
              "type": "string"
            },
            "private": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "deployment": {
          "type": "string",
          "enum": [
            "ftp",
            "ftps",
            "sftp",
            "git",
            "docker",
            "ci",
            "other"
          ]
        }
      },
      "additionalProperties": true
    },
    "briefing": {
      "type": "object",
      "description": "State of the agent briefing interview.",
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "ai_agents": {
                "const": true
              }
            },
            "required": [
              "ai_agents"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "required": [
          "agents"
        ],
        "properties": {
          "agents": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "billing": {
                "const": true
              }
            },
            "required": [
              "billing"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "required": [
          "security"
        ],
        "properties": {
          "security": {
            "required": [
              "audit_log"
            ],
            "properties": {
              "audit_log": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "privacy": {
            "properties": {
              "sensitive_data": {
                "const": true
              }
            },
            "required": [
              "sensitive_data"
            ]
          }
        },
        "required": [
          "privacy"
        ]
      },
      "then": {
        "required": [
          "security"
        ],
        "properties": {
          "security": {
            "required": [
              "audit_log",
              "mfa_privileged",
              "incident_response"
            ],
            "properties": {
              "audit_log": {
                "const": true
              },
              "mfa_privileged": {
                "const": true
              },
              "incident_response": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "privacy": {
            "properties": {
              "personal_data": {
                "const": true
              }
            },
            "required": [
              "personal_data"
            ]
          }
        },
        "required": [
          "privacy"
        ]
      },
      "then": {
        "properties": {
          "privacy": {
            "required": [
              "retention_policy"
            ],
            "properties": {
              "retention_policy": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
