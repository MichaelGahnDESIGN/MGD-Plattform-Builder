{
  "id": "woocommerce-extension-starter",
  "name": "MGD WooCommerce Extension Starter",
  "version": "0.1.0",
  "status": "pre-alpha",
  "platform": "woocommerce",
  "requirements": {
    "php": ">=8.1",
    "extensions": ["json", "mbstring"],
    "databases": { "core": { "engine": "wordpress", "required": true, "purpose": "WordPress/WooCommerce-Daten" } },
    "deployment": ["WordPress-Plugin-ZIP", "WP-CLI"]
  },
  "variants": { "light": "assets/css/admin-light.css", "dark": "assets/css/admin-dark.css" },
  "features": ["woocommerce-dependency-check", "order-hooks", "capability-checks", "data-minimization", "local-assets", "privacy-notes", "release-checklist"],
  "entry": "mgd-woocommerce-extension.php",
  "license": "LicenseRef-MGD",
  "license_label_paths": ["assets/css/powered-by.css"]
}
